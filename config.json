    },
    "digit": {
      "name": "迪哥",
      "title": "预算造价师",
      "role": "量房数据与报价分析",
      "temperature": 0.3,
      "model": "default",
      "enabled": true,
      "description": "量房数据录入、报价计算、材料用量估算"
    },
    "nova": {
      "name": "娜娜",
      "title": "首席设计师",
      "role": "方案设计与内容创作",
      "temperature": 0.7,
      "model": "default",
      "enabled": true,
      "description": "设计方案说明、效果图文案、案例包装"
    },
    "lex": {
      "name": "雷虎",
      "title": "法务主管",
      "role": "合同报价合规审核",
