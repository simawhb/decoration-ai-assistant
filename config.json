  "pipeline": ["scout", "digit", "nova", "lex", "memo"],
  "project_stages": [
    "线索获取",
    "量房报价",
    "设计方案",
    "合同签署",
    "开工施工",
    "水电验收",
    "泥木验收",
    "油漆验收",
    "竣工交付",
    "保修跟进"
